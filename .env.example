# Run ./Setup.command to fill these in privately on your Mac.
GIMB_EMAIL=
GIMB_PASSWORD=

# Choose a webhook OR an existing bot token and channel ID.
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

CHECK_TIME=18:00
TIMEZONE=Europe/Ljubljana
# Comma-separated pages. Each page gets its own snapshot.
WATCH_URLS=https://www.gimb.org/intranet/
# Follow relevant links in article content; ignore site navigation/related-article widgets.
FOLLOW_LINKS=true
LINK_DEPTH=2
MAX_PAGES=25
# Track documents on starting pages and their direct detail pages (not deeper forms libraries).
# Detect same-URL PDF/Word/Excel replacements by fingerprint.
TRACK_FILES=true
MAX_FILES=50
# Substitutions are excluded from this monitor.
TRACK_SUBSTITUTIONS=false
SCHOOL_CLASS=
# Optional CSS selector if the school's page layout needs adjustment.
CONTENT_SELECTOR=
# Exclude substitutions, weekly room changes, and lunch menus from links AND text diffs.
IGNORE_SELECTORS='a[href*="/nadomescanja/"], a[href*="selitve" i], a[href*="jedilnik" i]'
